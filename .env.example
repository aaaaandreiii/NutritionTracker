LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
SUGAR_PAI_EXTRACTION_MODEL=qwen2.5:latest
SUGAR_PAI_VISION_MODEL=gemma4:12b
SUGAR_PAI_DEFAULT_EXTRACTION_MODE=both
SUGAR_PAI_LLM_TIMEOUT_SECONDS=12
SUGAR_PAI_VISION_TIMEOUT_SECONDS=60
SUGAR_PAI_OCR_PROVIDER=tesseract
SUGAR_PAI_ENABLE_OFF_LOOKUP=false
VITE_API_BASE_URL=http://localhost:8000

# Optional telemetry mirror. Leave unset unless MLflow is installed and configured.
# MLFLOW_TRACKING_URI=http://localhost:5000
